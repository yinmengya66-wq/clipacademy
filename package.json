  "description": "剪映学堂 — 聚合多平台优质剪辑课程资源",
  "author": "ClipAcademy Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx",
