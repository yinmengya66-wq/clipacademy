{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "devCommand": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/src/data/seed.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
